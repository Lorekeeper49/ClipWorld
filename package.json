{
  "name": "clipworld",
  "productName": "ClipWorld",
  "version": "0.1.0",
  "description": "A smooth, ffmpeg-powered video editor",
  "author": "ClipWorld",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "electron-vite build && node tests/e2e/smoke.mjs && node tests/e2e/convert.mjs",
    "fetch-ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "package": "electron-vite build && electron-builder --win",
    "package:dir": "electron-vite build && electron-builder --win --dir"
  },
  "build": {
    "appId": "app.clipworld.editor",
    "productName": "ClipWorld",
    "directories": { "output": "dist" },
    "files": ["out/**/*", "package.json"],
    "extraResources": [{ "from": "vendor/ffmpeg", "to": "ffmpeg", "filter": ["ffmpeg.exe", "ffprobe.exe", "LICENSE*", "README*"] }],
    "fileAssociations": [{ "ext": "vcws", "name": "ClipWorld Project", "description": "ClipWorld video project", "role": "Editor" }],
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "dockview": "^8.9.0",
    "dockview-react": "^8.9.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "immer": "^11.2.10",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zustand": "^5.1.0"
  }
}
