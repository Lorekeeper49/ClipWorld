{
  "name": "clipworld",
  "productName": "ClipWorld",
  "version": "0.1.0",
  "description": "A smooth, ffmpeg-powered video editor",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fetch-ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "package": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "dockview": "^8.9.0",
    "dockview-react": "^8.9.0",
    "immer": "^11.2.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-vite": "^6.0.0",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
